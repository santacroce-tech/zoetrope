{
  "name": "zoetrope-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "sh ../scripts/build-wasm.sh && npm run player",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "player": "vite build --config vite.player.config.ts --logLevel warn",
    "test": "npm run test:build && node --test \"tests/dist/*.test.mjs\"",
    "test:build": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --target=node20 --outdir=tests/dist --out-extension:.js=.mjs --log-level=warning"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@tauri-apps/api": "^2",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7",
    "esbuild": "0.28.2"
  }
}
